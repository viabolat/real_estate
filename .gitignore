# Build intermediates — a successful build deletes these itself
clips/
work_silent.mp4
clips_draft/
work_draft.mp4

# Review rungs — never deliverables, never source
draft.mp4
contact_sheet.png

# Outputs — delivery and sample cuts are never source
out/
*.mp4

# Per-property branding assets — these change from listing to listing
logo.png
lower_third.png

# Listing working directories (per-property photos, config, deliverables)
agents/
photos/

# Shared asset library — per-property binaries, same reasoning as logo.png
global_assets/logos/*
global_assets/music/*
global_assets/lower_thirds/*
!global_assets/*/.gitkeep

# Per-listing build settings and state, and per-brand defaults
config.json
brand.json
.build.lock
.last_build.json

# Licensed audio — not redistributable via the repo
music.mp3

__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# LEADS AND PII — never commit. This repo is private, but a private repo is an
# access-control boundary, not a redaction one: it gets shared with a
# collaborator, cloned onto a second machine, or made public years later, and
# nothing re-reviews the history at that moment. These are named explicitly
# rather than left to a global ~/.gitignore_global rule, which does not travel
# with the repo -- leads.csv was covered only by a global *.csv rule.
#
# reason: every pattern below is on its own line with no trailing comment. git
# only treats "#" as a comment at the START of a line, so "scraper/paste.txt
# # raw dump" is a literal pattern containing spaces and matches nothing. That
# is how the first version of this block silently left leads.html and
# paste.txt -- the whole lead list and a raw scrape -- unignored.
# ---------------------------------------------------------------------------

# The lead list itself: agent names, phones, emails.
scraper/leads.csv
scraper/leads.html

# Raw Zillow dumps: agent name, phone, email, address.
scraper/paste.txt
scraper/beautified.txt
scraper/dumps/*
!scraper/dumps/.gitkeep

# Pre-agents/ scrape output, kept on disk for reference.
scraper/photos/

# Outreach scratch: client first names, a live Stripe payment link, and the
# delivery URLs for work already sold.
agents.txt
property_email.txt
outreach/

# ---------------------------------------------------------------------------
# IN-FLIGHT SCRATCH AND MACHINE-LOCAL CONFIG — deliberately not pushed.
#
# reason: spec.md is the working note for whatever is being built right now; it
# goes stale the moment that work ships, and a stale spec in a repo reads as
# current intent. settings.local.json is machine-local by its own naming
# convention. LOGIC_GUIDE.md is NOT here -- it is the decision record and ships
# with the repo, alongside CLAUDE.md and PROGRESS.md. Neither is tests/: a guard
# only guards if it runs on a clone, and check_pii.py scans only what git would
# publish, so ignoring it would drop the fixtures out of the PII gate.
# ---------------------------------------------------------------------------
spec.md
.claude/settings.local.json
