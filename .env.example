# Copy to .env and fill in. .env is gitignored and must never be committed.
# publish.py reads these; an exported shell variable always beats this file.
#
# The service_role key, not the anon key -- publish.py writes to the bucket.
# Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
